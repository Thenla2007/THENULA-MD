# Copy this file to .env and change the values.
PORT=3000
HOST=127.0.0.1
# Use a long random password. Dashboard login uses this password.
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Optional: set an OpenAI API key to enable AI chat replies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional owner number, digits only with country code (example: 94771234567)
OWNER_NUMBER=
